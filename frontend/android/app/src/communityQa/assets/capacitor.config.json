{
  "appId": "com.meteofriul.app.communityqa",
  "appName": "Meteo Fri\u00fbl Community QA",
  "webDir": "dist",
  "loggingBehavior": "none",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#005A96",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "PushNotifications": {
      "presentationOptions": [
        "alert",
        "sound"
      ]
    }
  }
}
