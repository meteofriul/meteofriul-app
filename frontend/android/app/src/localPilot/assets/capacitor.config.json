{
  "appId": "com.meteofriul.app.localpilot",
  "appName": "Meteo Friûl · Pilot locale",
  "webDir": "dist",
  "loggingBehavior": "none",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#005A96",
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "sound"]
    }
  }
}
