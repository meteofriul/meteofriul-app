{
  "appId": "com.meteofriul.app",
  "appName": "Meteo Friûl",
  "webDir": "dist",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#005A96",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "sound"]
    }
  }
}
