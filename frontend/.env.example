# Local browser builds use the Vite /api proxy. Cloudflare Pages production
# sets VITE_API_BASE to the exact tagged Cloud Run HTTPS endpoint.
VITE_API_BASE=/api

# Basemap canonica della mappa Territorio. La chiave CARTO è incorporata nel
# client per contratto: limitarla a domini/app autorizzati e non riutilizzarla.
# Positron viene usato nel tema chiaro, Dark Matter nel tema scuro. Le build
# Android ufficiali falliscono se la chiave manca; non esiste fallback ai tile
# diretti OpenStreetMap. OSM resta attribuito come sorgente dei dati cartografici.
VITE_TERRITORY_CARTO_API_KEY=
# VITE_TERRITORY_BASEMAP_MIN_ZOOM=5
# VITE_TERRITORY_BASEMAP_MAX_ZOOM=13

# Official ICON/CAMS weather planes. Open-Meteo is not a runtime provider for
# the current application.
VITE_WEATHER_PROVIDER_PRIMARY=autonomous
VITE_WEATHER_PROVIDER_OPERATOR_OVERRIDE=
VITE_WEATHER_V1_BASE_URL=https://meteofriul-weather-49007668366.europe-west1.run.app
VITE_NATIONAL_WEATHER_V2_BASE_URL=https://meteofriul-national-weather-49007668366.europe-west1.run.app
VITE_COMMUNITY_V2_ENABLED=1
VITE_COMMUNITY_API_BASE=https://meteofriul-community-49007668366.europe-west1.run.app/api

# Android must always use an absolute HTTPS API URL. Relative and HTTP values
# are rejected at runtime before any request can leave the app.
VITE_ANDROID_API_BASE=https://cfweb-bcee09e---meteofriul-api-bx24xqvcda-ew.a.run.app/api

# Public Ko-fi destination. This URL is not a credential or secret.
VITE_SUPPORT_URL=https://ko-fi.com/meteofriul

# Firebase Web public application configuration. These values identify the app;
# they are not server credentials. Analytics is intentionally not initialized.
VITE_FIREBASE_API_KEY=AIzaSyBwf2FHYpVAy0RmwNt1knp0QwOBjZBng70
VITE_FIREBASE_APP_ID=1:49007668366:web:a848e70da40a12eb852ddf
VITE_FIREBASE_AUTH_DOMAIN=meteo-friul.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=49007668366
VITE_FIREBASE_PROJECT_ID=meteo-friul
VITE_FIREBASE_STORAGE_BUCKET=meteo-friul.firebasestorage.app
VITE_FIREBASE_APP_CHECK_ENTERPRISE_SITE_KEY=6Lf-QoctAAAAAHwIacD7sA2a166596cSXI7ijObk

# Public Web Push certificate key from Firebase Console. It is versioned in the
# production config too; this variable allows an explicit local override.
VITE_FIREBASE_VAPID_KEY=BJMyuP76yQHJyT_kNFUBF8eVFy-DQotac3bHVoUwF88bCeNJVEfp8Gks11UEOgbJVk972o3AB6I9j7cPnkXmJ6Q

# Local App Check debug is opt-in and honored only by Vite development builds.
# Leave both values disabled/empty in production; never print a debug token.
VITE_FIREBASE_APP_CHECK_DEBUG=false
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
