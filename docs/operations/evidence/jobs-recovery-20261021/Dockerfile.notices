FROM python:3.13-slim AS tested
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /src
COPY backend/requirements.txt backend/requirements-dev.txt /src/backend/
RUN pip install --no-cache-dir -r backend/requirements-dev.txt
COPY backend/app /src/backend/app
COPY backend/tests /src/backend/tests
COPY experiments/weather_autonomy /src/experiments/weather_autonomy
COPY run_notice_tests.py /src/
RUN python /src/run_notice_tests.py
RUN echo verified >/src/notice-tests-passed
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt
COPY --from=tested /src/backend/app /app/app
COPY --from=tested /src/notice-tests-passed /app/notice-tests-passed
CMD ["python", "-m", "app.jobs.send_local_weather_notices"]
