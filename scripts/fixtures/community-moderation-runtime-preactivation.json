  "alertPolicies": [
    {
      "name": "projects/meteo-friul/alertPolicies/1111111111111111111",
      "displayName": "Meteo Friul - digest moderazione Community",
      "enabled": true,
      "severity": "WARNING",
      "combiner": "OR",
      "documentation": {
        "mimeType": "text/markdown",
        "content": "Nuove segnalazioni Territorio raggruppate in un digest sanitizzato. Usare il `group_ref` solo per correlare il gruppo tramite lo strumento operatore privato. Il log non contiene ID installazione, chiavi private o coordinate GPS."
      },
      "userLabels": {
        "service": "community-moderation",
        "signal": "digest-ready"
      },
      "conditions": [
        {
          "displayName": "Digest moderazione pronto",
          "type": "conditionMatchedLog",
          "filter": "log_id(\"meteofriul-community-moderation-digest\") AND jsonPayload.event=\"community_moderation_digest_ready\" AND severity=WARNING",
          "labelExtractors": []
        }
      ],
      "notificationChannels": [
        "projects/meteo-friul/notificationChannels/11334808831344967323"
      ],
      "notificationRateLimitPeriod": "3600s",
      "autoClose": "1800s",
      "notificationPrompts": ["OPENED"]
    },
    {
      "name": "projects/meteo-friul/alertPolicies/2222222222222222222",
      "displayName": "Meteo Friul - circuito moderazione Community fallito",
      "enabled": true,
      "severity": "ERROR",
      "combiner": "OR",
      "documentation": {
        "mimeType": "text/markdown",
        "content": "Errore del job o dello scheduler di moderazione Territorio. Controllare l'esecuzione `meteofriul-community-moderation-digest`; il digest non viene riconosciuto come consegnato finche' Cloud Logging non lo accetta."
      },
      "userLabels": {
        "service": "community-moderation",
        "signal": "runtime-failure"
      },
      "conditions": [
        {
          "displayName": "Errore job o scheduler moderazione",
          "type": "conditionMatchedLog",
          "filter": "severity>=ERROR AND ((resource.type=\"cloud_run_job\" AND resource.labels.job_name=\"meteofriul-community-moderation-digest\") OR (resource.type=\"cloud_scheduler_job\" AND resource.labels.job_id=\"community-moderation-digest\"))",
          "labelExtractors": []
        }
      ],
      "notificationChannels": [
        "projects/meteo-friul/notificationChannels/11334808831344967323"
      ],
      "notificationRateLimitPeriod": "3600s",
      "autoClose": "1800s",
      "notificationPrompts": ["OPENED"]
    }
  ],
